DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USERNAME:PASSWORD@HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-public-google-maps-api-key"
# Preferred satellite backup. Create an ArcGIS Location Platform API key with Basemaps privilege.
ESRI_API_KEY="your-arcgis-location-platform-api-key"
# MapTiler remains available for campus address search and as a secondary imagery backup.
MAPTILER_API_KEY="your-maptiler-api-key"
# Optional separate server key; the browser key also works for geocoding with allowed origins.
MAPTILER_SERVER_API_KEY=""
# Selects the interactive map imagery. Address search uses Google first, then MapTiler.
# Use esri to select Esri imagery immediately while Google Maps browser billing is inactive.
MAP_PROVIDER="auto"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_ALLOWED_EMAIL_DOMAINS="uc.edu.ph"
AUTH_ALLOWED_EMAILS="admin@example.com"
# Server-side UC HiveConnect config. On the same desktop, the sibling UC HiveConnect
# auth/supabase-jitsi.local.json is used by default. Set an absolute path elsewhere.
HIVECONNECT_CONFIG_PATH=""
# For a temporary remote demo, use Jitsi's public service instead of the local
# UC HiveConnect server. The interviewer must sign in to start the room.
HIVECONNECT_DEMO_MODE="false"
# Or configure all three values directly instead of using the JSON file:
# HIVECONNECT_APP_ID="uc-hiveconnect-hosts"
# HIVECONNECT_APP_SECRET="shared-jitsi-jwt-secret"
# HIVECONNECT_BASE_URL="https://your-hiveconnect-host"
SUPABASE_LEAVE_ATTACHMENTS_BUCKET="Leave Attachment"
SUPABASE_EMPLOYEE_DOCUMENTS_BUCKET="Employee Documents"
GCS_APPLICANT_REQUIREMENTS_BUCKET="workhive_requirements"
GCS_PROJECT_ID="your-google-cloud-project-id"
# New applicant ZIP archives go to private Cloudflare R2 Standard storage.
# Create a bucket-scoped Object Read & Write R2 API token. Keep these server-side.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_APPLICANT_REQUIREMENTS_BUCKET="your-private-r2-bucket-name"
# This app rejects new ZIP uploads when the R2 bucket reaches 8 GB.
# R2 remains usage-billed; this is not an account-wide billing cap.
# Brevo transactional email. Sender: ucworkhive@gmail.com. Replies go to the HR email in System Settings.
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_NAME="WorkHive HRMS"
# Public HTTPS URL of this app, used in password reset redirects and outgoing emails.
# Add https://your-workhive-host/reset-password to Supabase Auth's allowed redirect URLs.
WORKHIVE_PUBLIC_URL="https://your-workhive-host"
# Optional Python executable for HiveBot's bundled WorkHive classifier.
# Production Docker includes Python and the model dependencies automatically.
HIVEBOT_PYTHON=""
# Used by the daily holiday reminder job endpoint.
EMAIL_JOBS_SECRET="replace-with-a-long-random-secret"
